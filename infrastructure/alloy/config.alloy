loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

discovery.docker "containers" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "5s"
}

discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  rule {
    target_label = "job"
    replacement  = "docker"
  }

  rule {
    target_label = "host"
    replacement  = constants.hostname
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "service"
  }

  rule {
    source_labels = ["__meta_docker_container_log_stream"]
    target_label  = "stream"
  }
}

loki.source.docker "containers" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.docker.containers.targets
  relabel_rules = discovery.relabel.containers.rules
  forward_to    = [loki.write.local.receiver]
}

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"
    tls {
      insecure = true
    }
  }
}

prometheus.exporter.otlp "from_otlp" {
  // Этот exporter слушает OTLP и экспортирует в формате Prometheus
}

prometheus.remote_write "prometheus" {
  endpoint {
    url = "http://prometheus:9090/api/v1/write"
  }
}

otelcol.receiver.otlp "default" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }
  http {
    endpoint = "0.0.0.0:4318"
  }
  output {
    traces = [otelcol.exporter.otlp.tempo.input]
    metrics = [prometheus.exporter.otlp.from_otlp.input]
  }
}

prometheus.scrape "exporters" {
  targets = [
    {__address__ = "postgres-exporter:9187"},
    {__address__ = "keycloak-postgres-exporter:9187"},
    {__address__ = "kafka-exporter:9308"},
    {__address__ = "redis-exporter:6379"},
    {__address__ = "keycloak:9000"},
    {__address__ = "grafana:3000"},
    {__address__ = "schema-registry:8081"},
  ]

  scrape_interval = "15s"
  metrics_path    = "/metrics"

  forward_to = [prometheus.remote_write.prometheus.receiver]
}

prometheus.relabel "otlp_to_remote_write" {
  targets = prometheus.exporter.otlp.from_otlp.targets
  forward_to = [prometheus.remote_write.prometheus.receiver]
}