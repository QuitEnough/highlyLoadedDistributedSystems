@startuml
!includeurl https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

ContainerDb(clickhouse, "ClickHouse", "NoSQL Database", "Хранение событий и outbox")
ContainerDb(redis, "Redis", "In-Memory Cache", "Дедупликация device_id и distributed lock")
Container(kafka, "Kafka", "Message Broker", "Топики: events, devices")
Container(alloy, "Grafana Alloy", "OpenTelemetry Collector", "Агрегация observability")

Person(engineer, "Инженер", "DevOps-инженер")

Container_Boundary(events_collector, "events-collector-service") {
    Component(EventsCollector, "EventsCollector", "Spring @KafkaListener", "Потребляет Avro-события из топика 'events'")
    Component(EventProcessingService, "EventProcessingService", "Service", "Обрабатывает событие: дедупликация, запись")
    Component(DeviceEventRepository, "DeviceEventRepository", "ClickHouse JDBC", "Сохраняет события в device_events")
    Component(OutboxRepository, "OutboxRepository", "ClickHouse JDBC", "Работает с device_outbox")
    Component(DeviceDeduplicator, "DeviceDeduplicator", "Spring Data Redis", "Проверяет deviceId через Redis Set")
    Component(OutboxProcessor, "OutboxProcessor", "Spring @Scheduled", "CRON-задача с Redis-lock для публикации из outbox")
    Component(DeviceIdPublisher, "DeviceIdPublisher", "KafkaTemplate", "Публикует deviceId в топик 'devices'")
    Component(ObservabilityAdapter, "ObservabilityAdapter", "Micrometer + OpenTelemetry", "Экспорт в Grafana Alloy")
}

Rel(engineer, events_collector, "Мониторинг", "HTTP / Actuator")

Rel(kafka, EventsCollector, "Потребление DeviceEvent из топика 'events'", "Kafka Consumer (Avro)")
Rel(EventsCollector, EventProcessingService, "delegate(event)", "")

Rel(EventsCollector, DeviceDeduplicator, "Проверить deviceId", "")
Rel(DeviceDeduplicator, redis, "SADD devices:seen <deviceId>", "Redis")

Rel(EventProcessingService, DeviceEventRepository, "Сохранить событие в device_events", "")
Rel(EventProcessingService, OutboxRepository, "Если deviceId новый", "")

Rel(OutboxProcessor, redis, "SET outbox:lock NX PX", "Redis distributed lock")
Rel(OutboxProcessor, OutboxRepository, "SELECT * FROM device_outbox WHERE status=0", "ClickHouse")
Rel(OutboxProcessor, DeviceIdPublisher, "Для каждой записи", "")

Rel(DeviceIdPublisher, OutboxRepository, "UPDATE device_outbox SET status=1", "ClickHouse")
Rel(DeviceIdPublisher, kafka, "produce(deviceId) в топик 'devices'", "Kafka Producer")

Rel(events_collector, alloy, "Метрики, логи, трейсы", "OpenTelemetry / Micrometer")

@enduml