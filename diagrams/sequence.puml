@startuml
actor KafkaBroker
participant "DeviceCollectorService" as DCS
participant "AvroDeserializer" as AVRO
participant "ShardingSphere JDBC" as SSJDBC
database "PostgreSQL Shard N" as PGN
participant "KafkaProducer (DLT)" as KP

title Последовательность обработки сообщения об устройстве

KafkaBroker -> DCS : сообщение в Avro (Device ID, Payload)
activate DCS
DCS -> AVRO : десериализация Avro
activate AVRO
AVRO --> DCS : Device DTO (объект Java)
deactivate AVRO

alt Успешная обработка и запись
    DCS -> SSJDBC : сохранить/обновить устройство (по deviceId)
    activate SSJDBC
    SSJDBC -> PGN : insert/update (шард определяется по deviceId, ON CONFLICT)
    activate PGN
    PGN --> SSJDBC : Успех (Row updated/inserted)
    deactivate PGN
    SSJDBC --> DCS : Успех
    deactivate SSJDBC
    DCS -> DCS : логирование INFO, инкремент метрики успеха, commit offset
else Ошибка сохранения/шардинга (например, шард недоступен)
    DCS -> DCS : Повторные попытки (Retry with Backoff)...
    alt После N попыток неудача
        DCS -> KP : отправить в Dead Letter Topic (DLT)
        activate KP
        KP --> DCS : Подтверждение отправки в DLT
        deactivate KP
        DCS -> DCS : логирование ERROR, инкремент метрики ошибки, commit offset
    end
end

deactivate DCS
@enduml
