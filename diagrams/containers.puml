@startuml
!includeurl https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

Person(engineer, "Инженер", "DevOps-инженер, настраивает и мониторит платформу")
System_Ext(iot_device, "IoT Device", "Внешнее устройство: датчик, контроллер")
System_Boundary(iot_platform, "IoT Monitoring Platform") {

    ContainerDb(postgres, "PostgreSQL", "Database", "Реляционная БД: устройства, команды, процессы")
    ContainerDb(keycloak_postgres, "Keycloak PostgreSQL", "Database", "Хранение пользователей Keycloak")
    ContainerDb(clickhouse, "ClickHouse", "NoSQL Database", "Хранилище телеметрии IoT")

    Container(kafka, "Kafka", "Message Broker", "Шина событий, топики: events/dlt/device-id")
    Container(redis, "Redis", "In-Memory Cache", "Кэш, Pub/Sub")
    Container(minio, "MinIO", "Object Storage", "Хранение файлов (S3 API), DLT-ошибки")

    Container(keycloak, "Keycloak", "Identity Server", "SSO/OAuth2 сервер")
    Container(camunda, "Camunda", "BPM Engine", "Движок workflow-процессов")

    Container(schema_registry, "Schema Registry", "Confluent Schema Registry", "Управление Avro-схемами")

    Container(prometheus, "Prometheus", "Time Series DB", "Сохраняет метрики, опрашивает экспортеры")
    Container(grafana, "Grafana", "Dashboard UI", "Визуализация: метрики, логи, трейсы")
    Container(loki, "Loki", "Log Aggregator", "Сохраняет структурированные логи")
    Container(tempo, "Tempo", "Distributed Tracing", "Хранение трассировок")
    Container(alloy, "Grafana Alloy", "OpenTelemetry Collector", "Собирает метрики, логи и трейсы")

    Container(postgres_exporter, "Postgres Exporter", "Prometheus Exporter", "Собирает SQL-метрики из PostgreSQL")
    Container(keycloak_postgres_exporter, "Keycloak Postgres Exporter", "Prometheus Exporter", "Собирает SQL-метрики из Keycloak DB")
    Container(kafka_exporter, "Kafka Exporter", "Prometheus Exporter", "Собирает SQL-метрики из Kafka")
}

Rel(iot_device, kafka, "Телеметрия (Avro)", "Kafka/Avro [ПЛАНИРУЕТСЯ]")
Rel(engineer, grafana, "Мониторинг", "HTTP (дашборды)")
Rel(engineer, keycloak, "Вход в систему", "Keycloak (OIDC)")
Rel(engineer, camunda, "Мониторинг процессов", "HTTP (Camunda Cockpit)")

Rel(camunda, keycloak, "Аутентификация пользователей", "OIDC")

Rel(camunda, postgres, "Хранение процессов", "JDBC")
Rel(keycloak, keycloak_postgres, "Хранение пользователей", "JDBC")

Rel(postgres_exporter, postgres, "Подключение к БД", "PostgreSQL JDBC")
Rel(keycloak_postgres_exporter, keycloak_postgres, "Подключение к БД", "PostgreSQL JDBC")
Rel(kafka_exporter, kafka, "Подключение к Kafka", "Kafka client")

Rel(kafka, schema_registry, "Валидация схем при produce", "HTTP REST API")
Rel(schema_registry, kafka, "Хранение схем в _schemas", "Kafka producer")
Rel_D(schema_registry, kafka, "Чтение схем при consume", "Kafka consumer + HTTP")
Note on link
  **Avro workflow:**
  1. Producer регистрирует схему
  2. Consumer получает схему по ID
  3. Валидация на лету
end note

Rel(prometheus, postgres_exporter, "Scrape метрик PostgreSQL", "HTTP /metrics")
Rel(prometheus, keycloak_postgres_exporter, "Scrape метрик Keycloak DB", "HTTP /metrics")
Rel(prometheus, kafka_exporter, "Scrape метрик Kafka", "HTTP /metrics")
Rel(prometheus, keycloak, "Scrape метрик Keycloak", "HTTP /metrics")
Rel(prometheus, grafana, "Scrape метрик Grafana", "HTTP /metrics")
Rel(prometheus, alloy, "Scrape метрик Alloy", "HTTP /metrics")
Rel(prometheus, loki, "Scrape метрик Loki", "HTTP /metrics")
Rel(prometheus, tempo, "Scrape метрик Tempo", "HTTP /metrics")
Rel(prometheus, schema_registry, "Scrape метрик Schema Registry", "HTTP /metrics")

Rel(alloy, loki, "Отправка логов", "Loki Push API")
Rel(alloy, tempo, "Отправка трейсов", "OTLP/gRPC")

Rel(grafana, prometheus, "Чтение метрик", "Prometheus datasource")
Rel(grafana, loki, "Чтение логов", "Loki datasource")
Rel(grafana, tempo, "Чтение трейсов", "Tempo datasource")

@enduml