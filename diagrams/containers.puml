@startuml
!includeurl https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

Person(engineer, "Инженер", "DevOps-инженер, настраивает и мониторит платформу")
System_Ext(iot_device, "IoT Device", "Внешнее устройство: датчик, контроллер")

System_Boundary(iot_platform, "IoT Monitoring Platform") {

    ' --- Infrastructure ---
    Container(api_gateway, "API Gateway", "Spring Cloud Gateway", "Единая точка входа, SSL, Rate Limiting, Роутинг")
    Container(keycloak, "Keycloak", "Identity Server", "SSO/OAuth2 сервер")
    Container(kafka, "Kafka", "Message Broker", "Шина событий, топики: events/dlt/device-id")
    Container(schema_registry, "Schema Registry", "Confluent Schema Registry", "Управление Avro-схемами")
    Container(redis, "Redis", "In-Memory Cache", "Кэш, Pub/Sub")
    Container(camunda, "Camunda", "BPM Engine", "Движок workflow-процессов")
    Container(minio, "MinIO", "Object Storage", "Хранение файлов (S3 API), DLT-ошибки")
    ContainerDb(postgres, "PostgreSQL", "Database", "Реляционная БД: устройства, команды, процессы")
    ContainerDb(keycloak_postgres, "Keycloak PostgreSQL", "Database", "Хранение пользователей Keycloak")
    ContainerDb(clickhouse, "ClickHouse", "NoSQL Database", "Хранилище телеметрии IoT")
    ContainerDb(pg_shards, "PostgreSQL Shards", "Database", "Шардированная БД устройств (Shard 0, Shard 1)")

    ' --- Observability Stack ---
    Container(prometheus, "Prometheus", "Metrics Backend", "Хранит и анализирует метрики\n(получает только от Alloy)")
    Container(loki, "Loki", "Logging Backend", "Хранит и анализирует логи\n(получает только от Alloy)")
    Container(tempo, "Tempo", "Tracing Backend", "Хранит и анализирует трейсы\n(получает только от Alloy)")
    Container(grafana, "Grafana", "Dashboard UI", "Визуализация: метрики, логи, трейсы")
    Container(alloy, "Grafana Alloy", "OpenTelemetry Collector", "Собирает метрики, логи и трейсы")

    ' --- Exporters ---
    Container(postgres_exporter, "Postgres Exporter", "Prometheus Exporter", "Читает статистику БД")
    Container(keycloak_postgres_exporter, "Keycloak Postgres Exporter", "Prometheus Exporter", "Читает статистику БД")
    Container(kafka_exporter, "Kafka Exporter", "Prometheus Exporter", "Собирает метрики из Kafka")
    Container(redis_exporter, "Redis Exporter", "Prometheus Exporter", "Преобразует Redis INFO в /metrics")

    ' --- Microservices ---
    Container(events_collector, "events-collector-service", "Spring Boot 3.5", "Сбор и обработка событий из Kafka")
    Container(device_collector, "device-collector-service", "Spring Boot 3.5", "Сбор и обработка устройств из Kafka с шардированием")
    Container(device_service, "device-service", "Spring Boot 3.5", "CRUD API для устройств")
    Container(failed_events_processor, "failed-events-processor", "Spring Boot 3.5", "Обработка DLT-сообщений")
}

Rel(engineer, api_gateway, "HTTPS + JWT", "REST API")
Rel(api_gateway, device_service, "Маршрутизация запросов", "HTTP/Internal")
Rel(api_gateway, keycloak, "Проверка токена (опционально)", "OIDC")
Rel(iot_device, kafka, "Телеметрия (Avro)", "Kafka/Avro [ПЛАНИРУЕТСЯ]")
Rel(engineer, grafana, "Мониторинг", "HTTP (дашборды)")
Rel(engineer, keycloak, "Вход в систему", "Keycloak (OIDC)")
Rel(engineer, camunda, "Мониторинг процессов", "HTTP (Camunda Cockpit)")

Rel(kafka, events_collector, "Потребление событий из топика 'events'", "Kafka Consumer (Avro)")
Rel(events_collector, schema_registry, "Получение Avro-схемы", "HTTP REST")
Rel(events_collector, clickhouse, "INSERT device_events + device_outbox", "ClickHouse")
Rel(events_collector, redis, "Дедупликация device_id\nSADD devices:seen <id>\nTTL = 1h", "Redis Set + EXPIRE")
Rel(events_collector, kafka, "Отправка в топик 'devices'", "Kafka produce")
Rel(events_collector, alloy, "Метрики, логи, трейсы", "OpenTelemetry (Micrometer/Actuator)")

Rel(kafka, device_collector, "Потребление сообщений из топика 'device-id-topic'", "Kafka Consumer (Avro, Batch)")
Rel(device_collector, schema_registry, "Получение Avro-схемы", "HTTP REST")
Rel(device_collector, pg_shards, "INSERT/UPDATE устройств (ShardingSphere-JDBC, UPSERT ON CONFLICT)", "JDBC")
Rel(device_collector, kafka, "Отправка в Dead Letter Topic", "Kafka Producer (DLT)")
Rel(device_collector, alloy, "Метрики, логи, трейсы", "OpenTelemetry (Micrometer/Actuator)")

Rel(device_service, keycloak, "Валидация JWT (JWKS)", "HTTPS")
Rel(device_service, redis, "Кэш (Cache-Aside)", "Redis Protocol")
Rel(device_service, pg_shards, "Чтение данных (Read Model)", "JDBC/ShardingSphere")
Rel(device_service, kafka, "Команды записи (Write Model)", "Kafka Producer")
Rel(device_service, alloy, "Метрики, логи, трейсы", "OpenTelemetry (Micrometer/Actuator)")

Rel(kafka, failed_events_processor, "Потребление из dlt-topic", "Kafka Consumer (Avro/JSON)")
Rel(failed_events_processor, schema_registry, "Получение Avro-схемы", "HTTP REST")
Rel(failed_events_processor, minio, "S3 PUT → bucket 'failed-events'", "MinIO SDK (Java)")
Rel(failed_events_processor, alloy, "Метрики: processed_events_total, errors_total\nHealth: /actuator/health", "OpenTelemetry + Spring Actuator")

Rel(loki, minio, "S3 PUT/GET → bucket 'logs'\n(loki-config.yaml)", "AWS S3 API")
Rel(tempo, minio, "S3 PUT/GET → bucket 'traces'\n(tempo-config.yaml)", "AWS S3 API")
Rel(prometheus, minio, "Thanos Sidecar → bucket 'metrics'\n(thanos-objstore.yaml)", "AWS S3 API")

Rel(camunda, keycloak, "Аутентификация пользователей", "OIDC")
Rel(camunda, postgres, "Хранение процессов", "JDBC")
Rel(keycloak, keycloak_postgres, "Хранение пользователей", "JDBC")

Rel(postgres_exporter, alloy, "Push /metrics", "HTTP")
Rel(keycloak_postgres_exporter, alloy, "Push /metrics", "HTTP")
Rel(kafka_exporter, alloy, "Push /metrics", "HTTP")
Rel(redis_exporter, alloy, "Push /metrics", "HTTP")

Rel(alloy, prometheus, "Экспорт метрик", "Prometheus Remote Write")
Rel(alloy, loki, "Экспорт логов", "Loki Push API")
Rel(alloy, tempo, "Экспорт трейсов", "OTLP/gRPC")

Rel(kafka, schema_registry, "Валидация схем при produce", "HTTP REST API")

Rel(grafana, prometheus, "Чтение метрик", "Prometheus datasource")
Rel(grafana, loki, "Чтение логов", "Loki datasource")
Rel(grafana, tempo, "Чтение трейсов", "Tempo datasource")

@enduml